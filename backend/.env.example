# Ai_Web 后端配置。复制为 backend/.env 后填写；未填的项走下方默认值。
# 密钥类（L1）只允许出现在本文件或进程环境变量里，禁止写入数据库 app_settings。

########## 应用 ##########
AIWEB_APP__NAME=AI 问数
AIWEB_APP__ENVIRONMENT=local            # local | staging | prod
AIWEB_APP__HOST=127.0.0.1               # 本地开发只绑回环，避免局域网直连
AIWEB_APP__PORT=8000
AIWEB_APP__CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
AIWEB_APP__TIMEZONE=Asia/Shanghai
AIWEB_APP__REQUEST_ID_HEADER=X-Request-Id

########## 元数据库 / 知识库（远端 PostgreSQL） ##########
# 只存"关于表的知识"与应用自身数据，不存业务数据行。
AIWEB_PG__HOST=
AIWEB_PG__PORT=5432
AIWEB_PG__USER=
AIWEB_PG__PASSWORD=
AIWEB_PG__DATABASE=
AIWEB_PG__SCHEMA_NAME=aiweb             # alembic_version 也落在此 schema 内
AIWEB_PG__SSLMODE=prefer                # disable|allow|prefer|require|verify-ca|verify-full；留空=不启用
AIWEB_PG__CONNECT_TIMEOUT_S=10
AIWEB_PG__POOL_SIZE=5
AIWEB_PG__MAX_OVERFLOW=10
AIWEB_PG__ECHO=false
# pg 标记的集成用例库，与元数据库同为独立 database。不是 Settings 字段，
# 只被 tests/conftest.py 读取来决定 pg 用例是跑还是 skip。空值不要写行内注释。
# 形如 postgresql+asyncpg://aiweb_app:***@host:5432/aiweb_test
AIWEB_PG_TEST_DSN=

########## LLM（OpenAI 兼容端点） ##########
AIWEB_LLM__BASE_URL=
AIWEB_LLM__API_KEY=
AIWEB_LLM__MODEL=
AIWEB_LLM__TEMPERATURE=0
AIWEB_LLM__MAX_TOKENS=2000
AIWEB_LLM__TIMEOUT_S=60
# 只对 429/5xx/超时重试（指数退避）；生成 SQL 与分类都是幂等调用
AIWEB_LLM__MAX_RETRIES=2

# 未配置向量端点时检索走结构化路径，链路不断。
# 但 DIMENSION 从 0005（kb_card）起兼任 embedding 的**列宽**：建库前必须由超管先
# `CREATE EXTENSION vector;`（非 trusted，应用账号建不了），否则迁移必挂。见 ADR-0003 补注。
AIWEB_EMBEDDING__BASE_URL=
AIWEB_EMBEDDING__API_KEY=
AIWEB_EMBEDDING__MODEL=
AIWEB_EMBEDDING__DIMENSION=1536          # kb_card.embedding 的列宽；HNSW 上限 2000 维；0 = 关闭向量路（0005 之后 0 非法）

########## 鉴权与加密 ##########
# 值为空的键，说明写在上一行单列：`KEY=    # 说明` 里的说明会被读成值（见
# tests/unit/test_env_example.py::test_empty_values_have_no_inline_comment）。
AIWEB_JWT__SECRET=
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
AIWEB_JWT__ACCESS_TTL_S=900
AIWEB_JWT__REFRESH_TTL_S=86400
# 轮换时旧把留在后面（逗号分隔），解密仍按多把尝试：新把在前。
AIWEB_FERNET__KEYS=
# 生成：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# 下面两个只被 scripts/seed_admin.py 读取（不是 Settings 字段，无 __ 分隔符）。
# 口令留空则该脚本拒绝执行；建完 admin 建议从本文件撤掉。
AIWEB_BOOTSTRAP_ADMIN_USERNAME=admin
AIWEB_BOOTSTRAP_ADMIN_PASSWORD=

########## 元数据抽取 ##########
AIWEB_EXTRACT__MAX_TABLES=2000          # 超过则拒绝并提示配白名单
AIWEB_EXTRACT__BATCH_SIZE=200           # 一次 IN (...) 发出去多少张表（发送切片，不是提交单元：提交粒度是"每库一事务"，见 metadata-model §6 as-built(P3-020)）
AIWEB_EXTRACT__BATCH_INTERVAL_MS=100    # 批间歇一下，别把源库拖垮
AIWEB_EXTRACT__HEARTBEAT_INTERVAL_S=10
AIWEB_EXTRACT__STALE_JOB_RECLAIM_S=180
# 只存取值不存行数据；仅对 enum/set/短文本且低基数的列生效
# 这两个键至今没有功能读取点（NDV 采样整块归 P4，见 roadmap §P3 收口账），留着是为了那一片落地时口径已有名字。
AIWEB_EXTRACT__SAMPLE_DISTINCT=true
AIWEB_EXTRACT__SAMPLE_DISTINCT_MAX_DISTINCT=30
AIWEB_EXTRACT__MIN_MYSQL_VERSION=5.7
AIWEB_EXTRACT__MIN_PG_VERSION=12
# 卡片模板本身改了升它（int，写进 kb_index_profile.card_template_version）
AIWEB_EXTRACT__CARD_TEMPLATE_VERSION=1

########## 检索与问数 ##########
AIWEB_RETRIEVAL__FINAL_TABLES_K=5
AIWEB_RETRIEVAL__TOKEN_BUDGET=12000
AIWEB_RETRIEVAL__CATALOG_DIGEST_MAX_TABLES=1000   # 超过则先按关键词预筛再交给模型选表
AIWEB_RETRIEVAL__TRGM_THRESHOLD=0.08              # 中文短串分数极低，别指望它做语义
AIWEB_RETRIEVAL__ENABLE_REWRITE=false             # 开一次额外模型往返做指代消解
AIWEB_RETRIEVAL__FEW_SHOT_EXAMPLES=3
AIWEB_RETRIEVAL__FEW_SHOT_TOKEN_BUDGET=1500
AIWEB_RETRIEVAL__JOIN_HOPS=2                        # JOIN 桥表扩展深度：数的是桥表张数，不是边数
AIWEB_RETRIEVAL__MAX_JOIN_DEGREE=8                  # §5.3 的"候选度>8"：写侧字段度告警 + 图侧表度禁当桥

########## 对源库的查询执行 ##########
AIWEB_QUERY__ROW_LIMIT=1000
AIWEB_QUERY__TIMEOUT_MS=15000
AIWEB_QUERY__CONCURRENCY_PER_DS=2
AIWEB_QUERY__RATE_LIMIT_PER_USER_PER_MIN=20
AIWEB_QUERY__MAX_EXPLAIN_ROWS=50000000
AIWEB_QUERY__ALLOW_SQL_EDIT=admin       # admin | all | none

########## 结果集文件（不落元数据库） ##########
AIWEB_RESULT__DIR=data/results          # 相对路径按【仓库根】解析（工单 013），绝对路径原样保留
AIWEB_RESULT__RETENTION_DAYS=30
AIWEB_RESULT__PREVIEW_ROWS=200
AIWEB_RESULT__MAX_CELL_CHARS=1000
AIWEB_RESULT__MAX_PAYLOAD_MB=2

########## 知识 markdown 覆盖层 ##########
AIWEB_KB_DOCS__DIR=knowledge            # 同上：相对基准是仓库根，不是启动目录
AIWEB_KB_DOCS__AUTO_IMPORT=true         # 启动时把人工栏回写元数据库

########## 日志 ##########
AIWEB_LOGGING__LEVEL=INFO
AIWEB_LOGGING__JSON_OUTPUT=true
